<Window x:Class="Focus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:Focus.App.Localization"
        Title="Focus" Width="1240" Height="800" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Base}" FontSize="13"
        WindowStyle="None" Background="{StaticResource Brush.Window}" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Base}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Height="36" Margin="0,1">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="2"
                                        Background="Transparent" HorizontalAlignment="Left" Margin="4,0,0,0" />
                                <ContentPresenter Margin="16,0,10,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{StaticResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="#C7DFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="52" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- navigation rail -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,18,18,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Brush.Accent}">
                            <TextBlock Text="F" Foreground="#08121F" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Focus" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding [app.tagline], Source={x:Static loc:Loc.Inst}}"
                                       Style="{StaticResource Text.Muted}" FontSize="10.5" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Padding="18,12,18,16">
                    <StackPanel>
                        <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Ellipse x:Name="CaptureDot" Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{StaticResource Brush.TextMuted}" />
                            <TextBlock x:Name="CaptureStatusText" Style="{StaticResource Text.Muted}"
                                       Margin="8,0,0,0" FontSize="11" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <Ellipse x:Name="OverlayDot" Width="6" Height="6" VerticalAlignment="Center"
                                     Fill="{StaticResource Brush.TextMuted}" />
                            <TextBlock x:Name="OverlayStatusText" Style="{StaticResource Text.Muted}"
                                       Margin="8,0,0,0" FontSize="11" />
                        </StackPanel>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Text.Muted}" FontSize="10.5" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="10,0,10,0">
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="Nav" Tag="dashboard"
                                 Checked="OnNavChecked" IsChecked="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                       VerticalAlignment="Center" Width="20" />
                            <TextBlock Text="{Binding [nav.dashboard], Source={x:Static loc:Loc.Inst}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavEditor" Style="{StaticResource NavItem}" GroupName="Nav" Tag="editor"
                                 Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                       VerticalAlignment="Center" Width="20" />
                            <TextBlock Text="{Binding [nav.editor], Source={x:Static loc:Loc.Inst}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavProfiles" Style="{StaticResource NavItem}" GroupName="Nav" Tag="profiles"
                                 Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                       VerticalAlignment="Center" Width="20" />
                            <TextBlock Text="{Binding [nav.profiles], Source={x:Static loc:Loc.Inst}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSessions" Style="{StaticResource NavItem}" GroupName="Nav" Tag="sessions"
                                 Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                       VerticalAlignment="Center" Width="20" />
                            <TextBlock Text="{Binding [nav.sessions], Source={x:Static loc:Loc.Inst}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav" Tag="settings"
                                 Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                       VerticalAlignment="Center" Width="20" />
                            <TextBlock Text="{Binding [nav.settings], Source={x:Static loc:Loc.Inst}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Brush.Window}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Margin="26,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageSubtitle" Style="{StaticResource Text.Muted}" FontSize="11"
                                   Margin="0,1,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <Border x:Name="RecordingChip" Visibility="Collapsed" Background="#1E1416"
                                BorderBrush="#40232A" BorderThickness="1" CornerRadius="6"
                                Padding="9,4" Margin="0,0,10,0" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Danger}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RecordingChipText" Style="{StaticResource Text.Numeric}"
                                           FontSize="11" Margin="6,0,0,0" Foreground="#FFB4B4" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="HudChip" Style="{StaticResource Btn}" Height="28" Margin="0,0,6,0"
                                VerticalAlignment="Center" Click="OnToggleHud"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />

                        <Border Width="1" Background="{StaticResource Brush.Border}" Margin="8,14" />

                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximize" />
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Row="1" />

            <Border x:Name="Toast" Grid.Row="1" Background="{StaticResource Brush.SurfaceRaised}"
                    BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="8"
                    Padding="14,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <TextBlock x:Name="ToastText" FontSize="12.5" />
            </Border>
        </Grid>
    </Grid>
</Window>
