<Window x:Class="Focus.App.Dialogs.ProcessPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Focus.App.Localization"
        Title="Focus" Width="560" SizeToContent="Height" WindowStyle="None"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Window}" AllowsTransparency="False" FontFamily="{StaticResource Font.Base}" FontSize="13"
        BorderBrush="{StaticResource Brush.BorderStrong}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" Padding="20,16,16,8" MouseLeftButtonDown="OnHeaderDrag">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding [dashboard.selectProcess], Source={x:Static loc:Loc.Inst}}"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding [picker.hint], Source={x:Static loc:Loc.Inst}}"
                               Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Style="{StaticResource Btn.Icon}" Content="&#xE711;" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Click="OnCancel" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,6,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" />
            <Button Grid.Column="2" Style="{StaticResource Btn}" Click="OnRefresh"
                    Content="{Binding [ui.refresh], Source={x:Static loc:Loc.Inst}}" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="20,12,20,20">
            <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="8" Height="300">
                <ListBox x:Name="ProcessList" Margin="4" MouseDoubleClick="OnListDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource Text.Caption}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Pid}" Style="{StaticResource Text.Muted}"
                                           VerticalAlignment="Center" Margin="12,0,4,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock x:Name="EmptyHint" Style="{StaticResource Text.Muted}" Margin="2,8,0,0"
                       Text="{Binding [picker.empty], Source={x:Static loc:Loc.Inst}}" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource Btn}" Click="OnCancel"
                        Content="{Binding [common.cancel], Source={x:Static loc:Loc.Inst}}" />
                <Button Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="OnConfirm"
                        Content="{Binding [dashboard.attach], Source={x:Static loc:Loc.Inst}}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
