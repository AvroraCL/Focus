<UserControl x:Class="Focus.App.Views.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Focus.App.Controls"
             xmlns:loc="clr-namespace:Focus.App.Localization"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="ProfileCombo" Width="210" Height="30" FontSize="12"
                              SelectionChanged="OnProfileComboChanged" />
                    <Button Style="{StaticResource Btn.Icon}" Margin="6,0,0,0" Content="&#xE710;"
                            ToolTip="{Binding [profiles.new], Source={x:Static loc:Loc.Inst}}"
                            Click="OnNewProfile" />
                    <Button Style="{StaticResource Btn.Icon}" Content="&#xE792;"
                            ToolTip="{Binding [profiles.import], Source={x:Static loc:Loc.Inst}}"
                            Click="OnImportProfile" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="UndoButton" Style="{StaticResource Btn.Icon}" Content="&#xE7A7;"
                            ToolTip="{Binding [editor.undo], Source={x:Static loc:Loc.Inst}}" Click="OnUndo" />
                    <Button x:Name="RedoButton" Style="{StaticResource Btn.Icon}" Content="&#xE7A6;"
                            ToolTip="{Binding [editor.redo], Source={x:Static loc:Loc.Inst}}" Click="OnRedo" />
                    <Border Width="1" Background="{StaticResource Brush.Border}" Margin="8,5" />
                    <Button x:Name="AddButton" Style="{StaticResource Btn}" Height="30" Click="OnAddElement">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Font.Icons}" FontSize="10"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [editor.addElement], Source={x:Static loc:Loc.Inst}}"
                                       Margin="7,0,0,0" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Background="{StaticResource Brush.Border}" Margin="8,5" />
                    <StackPanel x:Name="AlignTools" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource Btn.Ghost}" Height="30" Padding="8,0" FontSize="11.5"
                                Content="{Binding [hud.align.left], Source={x:Static loc:Loc.Inst}}"
                                Tag="Left" Click="OnAlign" />
                        <Button Style="{StaticResource Btn.Ghost}" Height="30" Padding="8,0" FontSize="11.5"
                                Content="{Binding [hud.align.center], Source={x:Static loc:Loc.Inst}}"
                                Tag="Center" Click="OnAlign" />
                        <Button Style="{StaticResource Btn.Ghost}" Height="30" Padding="8,0" FontSize="11.5"
                                Content="{Binding [hud.align.right], Source={x:Static loc:Loc.Inst}}"
                                Tag="Right" Click="OnAlign" />
                        <Button Style="{StaticResource Btn.Ghost}" Height="30" Padding="8,0" FontSize="11.5"
                                Content="{Binding [hud.valign.top], Source={x:Static loc:Loc.Inst}}"
                                Tag="Top" Click="OnAlign" />
                        <Button Style="{StaticResource Btn.Ghost}" Height="30" Padding="8,0" FontSize="11.5"
                                Content="{Binding [hud.valign.center], Source={x:Static loc:Loc.Inst}}"
                                Tag="Middle" Click="OnAlign" />
                        <Button Style="{StaticResource Btn.Ghost}" Height="30" Padding="8,0" FontSize="11.5"
                                Content="{Binding [hud.valign.bottom], Source={x:Static loc:Loc.Inst}}"
                                Tag="Bottom" Click="OnAlign" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ToggleButton x:Name="GridToggle" Style="{StaticResource Btn.Chip}" IsChecked="True"
                                  Content="{Binding [editor.grid], Source={x:Static loc:Loc.Inst}}"
                                  Checked="OnGridToggle" Unchecked="OnGridToggle" />
                    <ToggleButton x:Name="SnapToggle" Style="{StaticResource Btn.Chip}" IsChecked="True" Margin="4,0,0,0"
                                  Content="{Binding [editor.snap], Source={x:Static loc:Loc.Inst}}"
                                  Checked="OnSnapToggle" Unchecked="OnSnapToggle" />
                    <Border Width="1" Background="{StaticResource Brush.Border}" Margin="10,5" />
                    <Button Style="{StaticResource Btn.Icon}" Content="&#x2212;" FontFamily="{StaticResource Font.Base}"
                            FontSize="14" Click="OnZoomOut" />
                    <TextBlock x:Name="ZoomText" Width="46" Text="100%" TextAlignment="Center"
                               FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                               VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}" />
                    <Button Style="{StaticResource Btn.Icon}" Content="+" FontFamily="{StaticResource Font.Base}"
                            FontSize="15" Click="OnZoomIn" />
                    <Button Style="{StaticResource Btn.Ghost}" Height="30" Padding="8,0" FontSize="11.5"
                            Content="{Binding [editor.fit], Source={x:Static loc:Loc.Inst}}" Click="OnZoomFit" />
                    <Border Width="1" Background="{StaticResource Brush.Border}" Margin="8,5" />
                    <TextBlock x:Name="SaveStateText" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"
                               Margin="2,0,10,0" />
                    <Button Style="{StaticResource Btn.Primary}" Height="30" Click="OnSave"
                            Content="{Binding [common.save], Source={x:Static loc:Loc.Inst}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- work area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="316" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,12,14,8">
                        <DockPanel>
                            <TextBlock Text="{Binding [editor.layers], Source={x:Static loc:Loc.Inst}}"
                                       Style="{StaticResource Text.SectionLabel}" />
                            <TextBlock x:Name="ElementCountText" Style="{StaticResource Text.Muted}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>
                    <ListBox x:Name="ElementList" Background="Transparent" BorderThickness="0" Margin="6,0,6,10"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="OnLayerSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="4,0,4,0" />
                                    <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Width="24" Height="24"
                                            FontSize="11" Content="{Binding VisibilityGlyph}" Foreground="{Binding VisibilityBrush}"
                                            Tag="{Binding}" Click="OnToggleVisibility" />
                                    <Button Grid.Column="3" Style="{StaticResource Btn.Icon}" Width="24" Height="24"
                                            FontSize="11" Content="{Binding LockGlyph}" Foreground="{Binding LockBrush}"
                                            Tag="{Binding}" Click="OnToggleLock" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#080A0D">
                <ui:DesignCanvas x:Name="Canvas" />
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12,16,10" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{Binding [editor.properties], Source={x:Static loc:Loc.Inst}}"
                                       Style="{StaticResource Text.SectionLabel}" />
                            <TextBlock x:Name="SelectionTitle" Style="{StaticResource Text.Subheading}"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,10,20">
                        <ui:PropertySheet x:Name="Properties" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- status -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="16,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusCanvasText" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="·" Style="{StaticResource Text.Muted}" Margin="8,0" />
                    <TextBlock x:Name="StatusSelectionText" Style="{StaticResource Text.Muted}" />
                </StackPanel>
                <TextBlock x:Name="StatusHintText" HorizontalAlignment="Right" Style="{StaticResource Text.Muted}"
                           Text="{Binding [editor.statusHint], Source={x:Static loc:Loc.Inst}}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
