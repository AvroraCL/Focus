<UserControl x:Class="Focus.App.Views.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Focus.App.Controls"
             xmlns:loc="clr-namespace:Focus.App.Localization"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Separate document controls from canvas tools so neither row overlaps. -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock x:Name="SaveStateText" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0" />
                        <Button Style="{StaticResource Btn.Primary}" Height="32" Click="OnSave"
                                Content="{Binding [common.save], Source={x:Static loc:Loc.Inst}}" ToolTip="Ctrl + S" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="ProfileCombo" Width="220" Height="32" SelectionChanged="OnProfileComboChanged"
                                  AutomationProperties.Name="{Binding [nav.profiles], Source={x:Static loc:Loc.Inst}}" />
                        <Button Style="{StaticResource Btn.Icon}" Margin="8,0,0,0" Content="&#xE710;" Click="OnNewProfile"
                                ToolTip="{Binding [profiles.new], Source={x:Static loc:Loc.Inst}}" />
                        <Button Style="{StaticResource Btn.Icon}" Content="&#xE792;" Click="OnImportProfile"
                                ToolTip="{Binding [profiles.import], Source={x:Static loc:Loc.Inst}}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ToggleButton x:Name="GridToggle" Style="{StaticResource Btn.Chip}" IsChecked="True"
                                      Content="{Binding [editor.grid], Source={x:Static loc:Loc.Inst}}" Checked="OnGridToggle" Unchecked="OnGridToggle" />
                        <ToggleButton x:Name="SnapToggle" Style="{StaticResource Btn.Chip}" IsChecked="True"
                                      Content="{Binding [editor.snap], Source={x:Static loc:Loc.Inst}}" Checked="OnSnapToggle" Unchecked="OnSnapToggle" />
                        <Border Width="1" Background="{StaticResource Brush.Border}" Margin="10,5" />
                        <Button Style="{StaticResource Btn.Icon}" Content="−" FontFamily="{StaticResource Font.Base}" Click="OnZoomOut" ToolTip="−" />
                        <TextBlock x:Name="ZoomText" Width="48" Text="100%" TextAlignment="Center" Style="{StaticResource Text.Numeric}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Btn.Icon}" Content="+" FontFamily="{StaticResource Font.Base}" Click="OnZoomIn" ToolTip="+" />
                        <Button Style="{StaticResource Btn.Ghost}" Height="30" Content="{Binding [editor.fit], Source={x:Static loc:Loc.Inst}}" Click="OnZoomFit" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="AddButton" Style="{StaticResource Btn}" Height="30" Click="OnAddElement"
                                Content="{Binding [editor.addElement], Source={x:Static loc:Loc.Inst}}" />
                        <Button x:Name="UndoButton" Style="{StaticResource Btn.Icon}" Content="&#xE7A7;" Margin="8,0,0,0" Click="OnUndo" ToolTip="Ctrl + Z" />
                        <Button x:Name="RedoButton" Style="{StaticResource Btn.Icon}" Content="&#xE7A6;" Click="OnRedo" ToolTip="Ctrl + Shift + Z" />
                        <ToggleButton x:Name="FocusCanvasToggle" Style="{StaticResource Btn.Chip}" Margin="8,0,0,0"
                                      Content="{Binding [editor.focusCanvas], Source={x:Static loc:Loc.Inst}}"
                                      ToolTip="{Binding [editor.focusHint], Source={x:Static loc:Loc.Inst}}"
                                      Checked="OnFocusCanvasChanged" Unchecked="OnFocusCanvasChanged" />
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="AlignTools" Orientation="Horizontal" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="{Binding [editor.arrange], Source={x:Static loc:Loc.Inst}}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Style="{StaticResource Btn.Ghost}" Height="28" Content="{Binding [hud.align.left], Source={x:Static loc:Loc.Inst}}" Tag="Left" Click="OnAlign" />
                    <Button Style="{StaticResource Btn.Ghost}" Height="28" Content="{Binding [hud.align.center], Source={x:Static loc:Loc.Inst}}" Tag="Center" Click="OnAlign" />
                    <Button Style="{StaticResource Btn.Ghost}" Height="28" Content="{Binding [hud.align.right], Source={x:Static loc:Loc.Inst}}" Tag="Right" Click="OnAlign" />
                    <Button Style="{StaticResource Btn.Ghost}" Height="28" Content="{Binding [hud.valign.top], Source={x:Static loc:Loc.Inst}}" Tag="Top" Click="OnAlign" />
                    <Button Style="{StaticResource Btn.Ghost}" Height="28" Content="{Binding [hud.valign.center], Source={x:Static loc:Loc.Inst}}" Tag="Middle" Click="OnAlign" />
                    <Button Style="{StaticResource Btn.Ghost}" Height="28" Content="{Binding [hud.valign.bottom], Source={x:Static loc:Loc.Inst}}" Tag="Bottom" Click="OnAlign" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- work area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LayerColumn" Width="184" MinWidth="160" MaxWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="PropertyColumn" Width="280" MinWidth="240" MaxWidth="400" />
            </Grid.ColumnDefinitions>

            <Border x:Name="LayerPanel" Grid.Column="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,12,14,8">
                        <DockPanel>
                            <TextBlock Text="{Binding [editor.layers], Source={x:Static loc:Loc.Inst}}"
                                       Style="{StaticResource Text.SectionLabel}" />
                            <TextBlock x:Name="ElementCountText" Style="{StaticResource Text.Muted}"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>
                    <ListBox x:Name="ElementList" Background="Transparent" BorderThickness="0" Margin="6,0,6,10"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="OnLayerSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="24" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="4,0,4,0" />
                                    <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Width="24" Height="24"
                                            FontSize="11" Content="{Binding VisibilityGlyph}" Foreground="{Binding VisibilityBrush}"
                                            Tag="{Binding}" Click="OnToggleVisibility" />
                                    <Button Grid.Column="3" Style="{StaticResource Btn.Icon}" Width="24" Height="24"
                                            FontSize="11" Content="{Binding LockGlyph}" Foreground="{Binding LockBrush}"
                                            Tag="{Binding}" Click="OnToggleLock" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="LeftResize" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Brush.Border}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
            <Grid Grid.Column="2" Background="{StaticResource Brush.Window}">
                <ui:DesignCanvas x:Name="Canvas" />
                <StackPanel x:Name="EmptyCanvasHint" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{Binding [editor.emptyTitle], Source={x:Static loc:Loc.Inst}}" Style="{StaticResource Text.Subheading}" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding [editor.emptyHint], Source={x:Static loc:Loc.Inst}}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
            <GridSplitter x:Name="RightResize" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Brush.Border}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
            <Border x:Name="PropertyPanel" Grid.Column="4" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12,16,10" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="{Binding [editor.properties], Source={x:Static loc:Loc.Inst}}"
                                       Style="{StaticResource Text.SectionLabel}" />
                            <TextBlock x:Name="SelectionTitle" Style="{StaticResource Text.Subheading}"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12,10,20">
                        <ui:PropertySheet x:Name="Properties" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- status -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="16,6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusCanvasText" Style="{StaticResource Text.Muted}" />
                    <TextBlock Text="·" Style="{StaticResource Text.Muted}" Margin="8,0" />
                    <TextBlock x:Name="StatusSelectionText" Style="{StaticResource Text.Muted}" />
                </StackPanel>
                <TextBlock x:Name="StatusHintText" Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource Text.Muted}"
                           Text="{Binding [editor.statusHint], Source={x:Static loc:Loc.Inst}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
