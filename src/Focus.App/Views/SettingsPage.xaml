<UserControl x:Class="Focus.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Focus.App.Localization"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,26,28,28" MaxWidth="1040" HorizontalAlignment="Stretch">
            <TextBlock x:Name="SavedIndicator" HorizontalAlignment="Right" Margin="0,-6,0,6" FontSize="11.5"
                       Foreground="{StaticResource Brush.Success}" Opacity="0" />
            <TextBlock Text="05 / PREFERENCES" Foreground="{StaticResource Brush.Accent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12" />
            <TextBlock Text="{Binding [nav.settings], Source={x:Static loc:Loc.Inst}}" Style="{StaticResource Text.Heading}" Margin="0,0,0,28" />
            <!-- general -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding [update.title], Source={x:Static loc:Loc.Inst}}" Style="{StaticResource Text.Subheading}" />
                        <TextBlock x:Name="UpdateVersion" HorizontalAlignment="Right" Style="{StaticResource Text.Numeric}" />
                    </DockPanel>
                    <CheckBox x:Name="AutoUpdateCheck" Margin="0,16,0,12" Content="{Binding [update.auto], Source={x:Static loc:Loc.Inst}}"
                              Checked="OnAutoUpdateChanged" Unchecked="OnAutoUpdateChanged" />
                    <TextBlock x:Name="UpdateState" TextWrapping="Wrap" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock x:Name="UpdateDetail" TextWrapping="Wrap" Style="{StaticResource Text.Caption}" Margin="0,0,0,12" />
                    <ProgressBar x:Name="UpdateProgress" Height="3" Minimum="0" Maximum="100" Margin="0,0,0,14" Visibility="Collapsed"
                                 Foreground="{StaticResource Brush.Accent}" Background="{StaticResource Brush.Border}" />
                    <WrapPanel>
                        <Button x:Name="CheckUpdateButton" Style="{StaticResource Btn}" Content="{Binding [update.check], Source={x:Static loc:Loc.Inst}}" Click="OnCheckUpdate" Margin="0,0,8,4" />
                        <Button x:Name="DownloadUpdateButton" Style="{StaticResource Btn.Primary}" Content="{Binding [update.download], Source={x:Static loc:Loc.Inst}}" Click="OnDownloadUpdate" Margin="0,0,8,4" />
                        <Button x:Name="InstallUpdateButton" Style="{StaticResource Btn.Primary}" Content="{Binding [update.install], Source={x:Static loc:Loc.Inst}}" Click="OnInstallUpdate" Margin="0,0,8,4" />
                        <Button x:Name="CancelUpdateButton" Style="{StaticResource Btn}" Content="{Binding [update.cancel], Source={x:Static loc:Loc.Inst}}" Click="OnCancelUpdate" Margin="0,0,8,4" />
                        <Button Style="{StaticResource Btn.Ghost}" Content="{Binding [update.notes], Source={x:Static loc:Loc.Inst}}" Click="OnReleaseNotes" Margin="0,0,0,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding [settings.general], Source={x:Static loc:Loc.Inst}}"
                               Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,14" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}"
                                   Text="{Binding [settings.language], Source={x:Static loc:Loc.Inst}}" />
                        <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                  SelectionChanged="OnLanguageChanged" />
                    </Grid>
                    <CheckBox x:Name="CloseToTrayCheck" Content="{Binding [settings.closeToTray], Source={x:Static loc:Loc.Inst}}"
                              Checked="OnCloseToTrayChanged" Unchecked="OnCloseToTrayChanged" />
                    <CheckBox x:Name="StartMinimizedCheck" Margin="0,10,0,0"
                              Content="{Binding [settings.startMinimized], Source={x:Static loc:Loc.Inst}}"
                              Checked="OnStartMinimizedChanged" Unchecked="OnStartMinimizedChanged" />
                </StackPanel>
            </Border>

            <!-- capture -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding [settings.capture], Source={x:Static loc:Loc.Inst}}"
                               Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,14" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}"
                                   Text="{Binding [settings.hardwareInterval], Source={x:Static loc:Loc.Inst}}" />
                        <ComboBox x:Name="HardwareIntervalCombo" Grid.Column="1" Width="140" HorizontalAlignment="Left"
                                  SelectionChanged="OnHardwareIntervalChanged" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}"
                                   Text="{Binding [settings.uiRefresh], Source={x:Static loc:Loc.Inst}}" />
                        <ComboBox x:Name="UiRefreshCombo" Grid.Column="1" Width="140" HorizontalAlignment="Left"
                                  SelectionChanged="OnUiRefreshChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- overlay -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding [settings.overlay], Source={x:Static loc:Loc.Inst}}"
                               Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,14" />
                    <CheckBox x:Name="OnlyWhenFocusedCheck"
                              Content="{Binding [settings.onlyWhenFocused], Source={x:Static loc:Loc.Inst}}"
                              Checked="OnOnlyWhenFocusedChanged" Unchecked="OnOnlyWhenFocusedChanged" />
                    <TextBlock Style="{StaticResource RowHint}" Margin="24,6,0,0"
                               Text="{Binding [settings.overlayHint], Source={x:Static loc:Loc.Inst}}" />
                </StackPanel>
            </Border>

            <!-- recording -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding [settings.recording], Source={x:Static loc:Loc.Inst}}"
                               Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,14" />
                    <CheckBox x:Name="AutoRecordCheck"
                              Content="{Binding [settings.autoRecord], Source={x:Static loc:Loc.Inst}}"
                              Checked="OnAutoRecordChanged" Unchecked="OnAutoRecordChanged" />
                </StackPanel>
            </Border>

            <!-- hotkeys -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding [settings.hotkeys], Source={x:Static loc:Loc.Inst}}"
                               Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}"
                                   Text="{Binding [settings.toggleHud], Source={x:Static loc:Loc.Inst}}" />
                        <TextBlock x:Name="ToggleHudKeys" Grid.Column="1" Style="{StaticResource Text.Numeric}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Height="28" FontSize="11.5"
                                Content="{Binding [settings.changeKey], Source={x:Static loc:Loc.Inst}}"
                                Tag="ToggleHud" Click="OnCaptureHotkey" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}"
                                   Text="{Binding [settings.toggleRecording], Source={x:Static loc:Loc.Inst}}" />
                        <TextBlock x:Name="ToggleRecordingKeys" Grid.Column="1" Style="{StaticResource Text.Numeric}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Height="28" FontSize="11.5"
                                Content="{Binding [settings.changeKey], Source={x:Static loc:Loc.Inst}}"
                                Tag="ToggleRecording" Click="OnCaptureHotkey" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}"
                                   Text="{Binding [settings.cycleProfile], Source={x:Static loc:Loc.Inst}}" />
                        <TextBlock x:Name="CycleProfileKeys" Grid.Column="1" Style="{StaticResource Text.Numeric}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Height="28" FontSize="11.5"
                                Content="{Binding [settings.changeKey], Source={x:Static loc:Loc.Inst}}"
                                Tag="CycleProfile" Click="OnCaptureHotkey" />
                    </Grid>

                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource RowHint}" Margin="0,12,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- permissions / telemetry -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding [settings.permissions], Source={x:Static loc:Loc.Inst}}"
                               Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,14" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}"
                                   Text="{Binding [settings.permissions], Source={x:Static loc:Loc.Inst}}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="AdminDot" Width="7" Height="7" VerticalAlignment="Center" />
                            <TextBlock x:Name="AdminStatus" Style="{StaticResource RowHint}" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button x:Name="ElevateButton" Grid.Column="2" Style="{StaticResource Btn}" Height="28"
                                FontSize="11.5" Click="OnElevate"
                                Content="{Binding [settings.restartAdmin], Source={x:Static loc:Loc.Inst}}" />
                    </Grid>

                    <TextBlock Text="{Binding [settings.telemetry], Source={x:Static loc:Loc.Inst}}"
                               Style="{StaticResource Text.SectionLabel}" Margin="0,8,0,12" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}"
                                   Text="{Binding [settings.etw], Source={x:Static loc:Loc.Inst}}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="EtwDot" Width="7" Height="7" VerticalAlignment="Center" />
                            <TextBlock x:Name="EtwStatus" Style="{StaticResource RowHint}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}"
                                   Text="{Binding [settings.hardware], Source={x:Static loc:Loc.Inst}}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="HardwareDot" Width="7" Height="7" VerticalAlignment="Center" />
                            <TextBlock x:Name="HardwareStatus" Style="{StaticResource RowHint}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- diagnostics -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding [settings.diagnostics], Source={x:Static loc:Loc.Inst}}"
                               Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,14" />
                    <TextBlock Text="{Binding [settings.diagnosticsHint], Source={x:Static loc:Loc.Inst}}"
                               Style="{StaticResource RowHint}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Btn}" Height="28" FontSize="11.5" Click="OnCopyDiagnostics"
                                Content="{Binding [settings.copyDiagnostics], Source={x:Static loc:Loc.Inst}}" />
                        <TextBlock x:Name="DiagnosticsState" Style="{StaticResource RowHint}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- about -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding [settings.about], Source={x:Static loc:Loc.Inst}}"
                               Style="{StaticResource Text.SectionLabel}" Margin="0,0,0,14" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}"
                                   Text="{Binding [settings.version], Source={x:Static loc:Loc.Inst}}" />
                        <TextBlock x:Name="VersionText" Grid.Column="1" Style="{StaticResource Text.Numeric}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabel}"
                                   Text="{Binding [settings.dataFolder], Source={x:Static loc:Loc.Inst}}" />
                        <TextBlock x:Name="DataFolderText" Grid.Column="1" Style="{StaticResource Text.Numeric}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" Style="{StaticResource Btn}" Height="28" FontSize="11.5" Click="OnOpenDataFolder"
                                Content="{Binding [settings.openFolder], Source={x:Static loc:Loc.Inst}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
