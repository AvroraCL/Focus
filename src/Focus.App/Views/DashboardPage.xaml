<UserControl x:Class="Focus.App.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Focus.App.Controls"
             xmlns:loc="clr-namespace:Focus.App.Localization"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,10" /><Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" /><Setter Property="BorderThickness" Value="1,0,0,0" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel Margin="28,26,22,28" MaxWidth="1240" HorizontalAlignment="Stretch">

            <StackPanel Margin="0,0,0,28">
                <TextBlock Text="01 / LIVE PERFORMANCE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brush.Accent}" Margin="0,0,0,12" />
                <TextBlock Text="{Binding [dashboard.workspaceTitle], Source={x:Static loc:Loc.Inst}}" Style="{StaticResource Text.Heading}" />
                <TextBlock Text="{Binding [dashboard.workspaceHint], Source={x:Static loc:Loc.Inst}}" Style="{StaticResource Text.Caption}" Margin="0,7,0,0" />
            </StackPanel>
            <Border x:Name="AdminBanner" Visibility="Collapsed" Background="#F0E9DA" BorderBrush="#D8CBB4"
                    BorderThickness="1" CornerRadius="0" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Font.Icons}" FontSize="16"
                               Foreground="{StaticResource Brush.Warning}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding [dashboard.adminRequired], Source={x:Static loc:Loc.Inst}}"
                                   FontWeight="SemiBold" Foreground="{StaticResource Brush.Warning}" />
                        <TextBlock Text="{Binding [dashboard.adminHint], Source={x:Static loc:Loc.Inst}}"
                                   Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="ElevateButton" Style="{StaticResource Btn}"
                            Content="{Binding [dashboard.restartAsAdmin], Source={x:Static loc:Loc.Inst}}"
                            VerticalAlignment="Center" Click="OnElevateClick" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="0,20,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{StaticResource Brush.TextMuted}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [dashboard.target], Source={x:Static loc:Loc.Inst}}"
                                       Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
                            <TextBlock x:Name="TargetNameText" Margin="8,0,0,0" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" />
                            <Button x:Name="NoTargetButton" Style="{StaticResource Btn.Ghost}" Height="24"
                                    Padding="8,0" FontSize="11.5" Margin="10,0,0,0"
                                    Content="{Binding [dashboard.selectProcess], Source={x:Static loc:Loc.Inst}}"
                                    Click="OnSelectProcessClick" Visibility="Collapsed" />
                            <Button x:Name="DetachButton" Style="{StaticResource Btn.Ghost}" Height="24"
                                    Padding="8,0" FontSize="11.5" Margin="2,0,0,0"
                                    Content="{Binding [dashboard.detach], Source={x:Static loc:Loc.Inst}}"
                                    Click="OnDetachClick" Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="FpsText" Text="—" FontFamily="{StaticResource Font.Base}"
                                       FontSize="88" FontWeight="Bold" Foreground="{StaticResource Brush.TextMuted}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Text="FPS" Margin="10,0,0,12" FontSize="13"
                                       Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Bottom" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="3,0,0,0">
                            <TextBlock Text="{Binding [dashboard.frametime], Source={x:Static loc:Loc.Inst}}"
                                       Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            <TextBlock x:Name="FrameTimeText" Margin="8,0,0,0" Style="{StaticResource Text.Numeric}"
                                       FontSize="12" />
                            <TextBlock x:Name="FrameStatusText" Margin="16,0,0,0" Style="{StaticResource Text.Muted}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <ui:Sparkline x:Name="FrameSpark" Height="66" Margin="0,10,0,0" StrokeColor="#DB3024" />
                    </StackPanel>

                    <UniformGrid Grid.Column="1" Columns="2" Rows="2" Width="280" Margin="32,0,0,0"
                                 VerticalAlignment="Center">
                        <Border Style="{StaticResource Tile}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileLabel}"
                                           Text="{Binding [dashboard.avg], Source={x:Static loc:Loc.Inst}}" />
                                <TextBlock x:Name="AvgFpsText" Style="{StaticResource TileValue}" Text="—"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileLabel}" Text="1% Low" />
                                <TextBlock x:Name="Low1Text" Style="{StaticResource TileValue}" Text="—"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileLabel}" Text="0.1% Low" />
                                <TextBlock x:Name="Low01Text" Style="{StaticResource TileValue}" Text="—"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TileLabel}"
                                           Text="{Binding [dashboard.sessionTime], Source={x:Static loc:Loc.Inst}}" />
                                <TextBlock x:Name="DurationText" Style="{StaticResource TileValue}" Text="—"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding [dashboard.overlay], Source={x:Static loc:Loc.Inst}}"
                                       Style="{StaticResource Text.SectionLabel}" />
                            <TextBlock x:Name="OverlayProfileText" FontSize="15.5" FontWeight="SemiBold"
                                       Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Ellipse x:Name="OverlayDot" Width="6" Height="6" VerticalAlignment="Center"
                                         Fill="{StaticResource Brush.TextMuted}" />
                                <TextBlock x:Name="OverlayStateText" Style="{StaticResource Text.Caption}"
                                           Margin="7,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="OverlayToggleButton" Style="{StaticResource Btn}" MinWidth="76"
                                    Click="OnToggleOverlay" />
                            <Button Style="{StaticResource Btn.Ghost}" Margin="6,0,0,0"
                                    Content="{Binding [profiles.edit], Source={x:Static loc:Loc.Inst}}"
                                    Click="OnEditHud" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding [dashboard.session], Source={x:Static loc:Loc.Inst}}"
                                       Style="{StaticResource Text.SectionLabel}" />
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock x:Name="RecordTimerText" FontFamily="{StaticResource Font.Mono}"
                                           FontSize="15.5" FontWeight="SemiBold" Text="00:00" />
                                <Ellipse x:Name="RecordDot" Width="7" Height="7" Fill="{StaticResource Brush.Danger}"
                                         Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="SessionInfoText" Style="{StaticResource Text.Caption}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="RecordButton" Style="{StaticResource Btn.Primary}"
                                MinWidth="96" VerticalAlignment="Center" Click="OnToggleRecording" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding [dashboard.gpu], Source={x:Static loc:Loc.Inst}}"
                                       Style="{StaticResource Text.SectionLabel}" />
                            <TextBlock x:Name="GpuNameText" Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="GpuUsageText" Text="—" FontFamily="{StaticResource Font.Mono}"
                                       FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="%" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"
                                       Margin="4,0,0,6" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <ui:MetricBar x:Name="GpuUsageBar" Height="5" Margin="0,6,0,0" FillColor="#181818" />
                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <StackPanel Margin="0,0,0,7">
                                <TextBlock Style="{StaticResource DetailLabel}"
                                           Text="{Binding [dashboard.temp], Source={x:Static loc:Loc.Inst}}" />
                                <TextBlock x:Name="GpuTempText" Style="{StaticResource DetailValue}" Text="—" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,7">
                                <TextBlock Style="{StaticResource DetailLabel}"
                                           Text="{Binding [dashboard.clock], Source={x:Static loc:Loc.Inst}}" />
                                <TextBlock x:Name="GpuClockText" Style="{StaticResource DetailValue}" Text="—" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource DetailLabel}"
                                           Text="{Binding [dashboard.power], Source={x:Static loc:Loc.Inst}}" />
                                <TextBlock x:Name="GpuPowerText" Style="{StaticResource DetailValue}" Text="—" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource DetailLabel}"
                                           Text="{Binding [dashboard.vram], Source={x:Static loc:Loc.Inst}}" />
                                <TextBlock x:Name="VramText" Style="{StaticResource DetailValue}" Text="—" />
                            </StackPanel>
                        </UniformGrid>
                        <ui:Sparkline x:Name="GpuSpark" Height="34" Margin="0,10,0,0" StrokeColor="#181818" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="{Binding [dashboard.cpu], Source={x:Static loc:Loc.Inst}}"
                                       Style="{StaticResource Text.SectionLabel}" />
                            <TextBlock x:Name="CpuNameText" Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="CpuUsageText" Text="—" FontFamily="{StaticResource Font.Mono}"
                                       FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="%" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"
                                       Margin="4,0,0,6" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <ui:MetricBar x:Name="CpuUsageBar" Height="5" Margin="0,6,0,0" />
                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <StackPanel Margin="0,0,0,7">
                                <TextBlock Style="{StaticResource DetailLabel}"
                                           Text="{Binding [dashboard.temp], Source={x:Static loc:Loc.Inst}}" />
                                <TextBlock x:Name="CpuTempText" Style="{StaticResource DetailValue}" Text="—" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,7">
                                <TextBlock Style="{StaticResource DetailLabel}"
                                           Text="{Binding [dashboard.clock], Source={x:Static loc:Loc.Inst}}" />
                                <TextBlock x:Name="CpuClockText" Style="{StaticResource DetailValue}" Text="—" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource DetailLabel}"
                                           Text="{Binding [dashboard.power], Source={x:Static loc:Loc.Inst}}" />
                                <TextBlock x:Name="CpuPowerText" Style="{StaticResource DetailValue}" Text="—" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource DetailLabel}"
                                           Text="{Binding [dashboard.cores], Source={x:Static loc:Loc.Inst}}" />
                                <TextBlock x:Name="CoreCountText" Style="{StaticResource DetailValue}" Text="—" />
                            </StackPanel>
                        </UniformGrid>
                        <ui:CoreUsageStrip x:Name="CoreStrip" Height="34" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding [dashboard.memory], Source={x:Static loc:Loc.Inst}}"
                                   Style="{StaticResource Text.SectionLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="RamPercentText" Text="—" FontFamily="{StaticResource Font.Mono}"
                                       FontSize="30" FontWeight="Bold" />
                            <TextBlock Text="%" Foreground="{StaticResource Brush.TextSecondary}" FontSize="13"
                                       Margin="4,0,0,6" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <ui:MetricBar x:Name="RamBar" Height="5" Margin="0,6,0,0" />
                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <StackPanel Margin="0,0,0,7">
                                <TextBlock Style="{StaticResource DetailLabel}"
                                           Text="{Binding [dashboard.memory], Source={x:Static loc:Loc.Inst}}" />
                                <TextBlock x:Name="RamText" Style="{StaticResource DetailValue}" Text="—" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,7">
                                <TextBlock Style="{StaticResource DetailLabel}"
                                           Text="{Binding [dashboard.vram], Source={x:Static loc:Loc.Inst}}" />
                                <TextBlock x:Name="VramDetailText" Style="{StaticResource DetailValue}" Text="—" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource DetailLabel}"
                                           Text="{Binding [metric.GpuMemoryPercent], Source={x:Static loc:Loc.Inst}}" />
                                <TextBlock x:Name="VramPercentText" Style="{StaticResource DetailValue}" Text="—" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource DetailLabel}"
                                           Text="{Binding [metric.ProcessWorkingSet], Source={x:Static loc:Loc.Inst}}" />
                                <TextBlock x:Name="ProcessMemText" Style="{StaticResource DetailValue}" Text="—" />
                            </StackPanel>
                        </UniformGrid>
                        <ui:Sparkline x:Name="RamSpark" Height="34" Margin="0,10,0,0" StrokeColor="#686862" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
